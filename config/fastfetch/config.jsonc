{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "source": "arch_small",
        "color": {
            "1": "magenta",
            "2": "cyan"
        },
        "padding": {
            "top": 5,
            "left": 2,
            "right": 3
        }
    },
    "display": {
        "separator": " "
    },
    "modules": [
        {
            "type": "title",
            "format": "╭─ {#1;35}{user-name}@{#1;35}{host-name}{#} ─────────────────────────────╮"
        },
        {
            "type": "os",
            "key": "│ {#35}󰌽 os      {#keys}│",
            "format": "{name} {arch}"
        },
        {
            "type": "host",
            "key": "│ {#35}󰌢 host    {#keys}│",
            "format": "{name}"
        },
        {
            "type": "kernel",
            "key": "│ {#35} kernel  {#keys}│",
            "format": "{release}"
        },
        {
            "type": "uptime",
            "key": "│ {#35}󰅐 uptime  {#keys}│"
        },
        {
            "type": "packages",
            "key": "│ {#35}󰏖 pkgs    {#keys}│",
            "format": "{all} (pacman)"
        },
        {
            "type": "custom",
            "format": "├─ {#1;34}Desktop & Shell{#} ────────────────────────╮"
        },
        {
            "type": "wm",
            "key": "│ {#34}󱂬 wm      {#keys}│",
            "format": "{pretty-name} {version}"
        },
        {
            "type": "custom",
            "key": "│ {#34}󰖲 shell   {#keys}│",
            "format": "Quickshell (Material You)"
        },
        {
            "type": "terminal",
            "key": "│ {#34}󰞷 term    {#keys}│",
            "format": "{pretty-name}"
        },
        {
            "type": "custom",
            "format": "├─ {#1;32}Hardware & Power{#} ───────────────────────╮"
        },
        {
            "type": "cpu",
            "key": "│ {#32}󰍛 cpu     {#keys}│",
            "format": "{name} ({cores-logical}) @ {freq-max}"
        },
        {
            "type": "gpu",
            "key": "│ {#32}󰢮 gpu     {#keys}│",
            "format": "{name} [{type}]"
        },
        {
            "type": "memory",
            "key": "│ {#32}󰘚 memory  {#keys}│",
            "format": "{used} / {total} ({percentage})"
        },
        {
            "type": "disk",
            "key": "│ {#32}󰋊 disk    {#keys}│",
            "folders": "/",
            "format": "{size-used} / {size-total} ({size-percentage})"
        },
        {
            "type": "battery",
            "key": "│ {#32}󰂄 battery {#keys}│",
            "format": "{capacity} [{status}]"
        },
        {
            "type": "custom",
            "format": "├─ {#1;36}Theme & Colors{#} ────────────────────────╮"
        },
        {
            "type": "colors",
            "key": "│ {#36}󰏘 palette {#keys}│",
            "symbol": "circle"
        },
        {
            "type": "custom",
            "format": "╰───────────────────────────────────────────╯"
        }
    ]
}
