{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "small",
        "color": {
            "1": "magenta",
            "2": "cyan"
        },
        "padding": {
            "top": 0,
            "left": 1,
            "right": 2
        }
    },
    "display": {
        "separator": "  ",
        "color": {
            "keys": "magenta",
            "title": "cyan"
        },
        "size": {
            "ndigits": 1
        }
    },
    "modules": [
        {
            "type": "title",
            "format": "{#1;35}{user-name}{#}{#90}@{host-name}{#}"
        },
        {
            "type": "os",
            "key": "󰌽 os  ",
            "format": "{name}"
        },
        {
            "type": "wm",
            "key": "󱂬 wm  ",
            "format": "{pretty-name}"
        },
        {
            "type": "terminal",
            "key": "󰞷 term",
            "format": "{pretty-name}"
        },
        {
            "type": "command",
            "key": "󰍛 cpu ",
            "text": "sh -c 'cores=$(nproc); name=$(lscpu | awk -F: \"/Model name/ {print \\$2; exit}\" | sed -E \"s/([0-9]+th Gen |Intel\\(R\\) |Core\\(TM\\) |Xeon\\(R\\) |AMD |with Radeon Graphics|@.*|CPU )//g\" | xargs); echo \"$name ($cores)\"'"
        },
        {
            "type": "gpu",
            "key": "󰢮 gpu ",
            "hideType": "integrated",
            "format": "{2}"
        },
        {
            "type": "memory",
            "key": "󰘚 mem ",
            "format": "{1} / {2}"
        },
        {
            "type": "uptime",
            "key": "󰅐 up  ",
            "format": "{?1}{1}d {?}{2}h {3}m"
        },
        {
            "type": "colors",
            "symbol": "circle"
        }
    ]
}
